{
  "name": "git-submodule-update",
  "displayName": "Git Submodule Update",
  "description": "Adds Source Control toolbar buttons, a Submodules submenu, and a per-submodule list for git submodule update (--init/--remote).",
  "version": "1.1.0",
  "publisher": "at-besa",
  "icon": "images/icon.png",
  "license": "GPL-3.0-only",
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "submodule",
    "submodules",
    "scm",
    "source control",
    "update",
    "init",
    "recursive"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "submoduleUpdate.init",
        "title": "Init All",
        "category": "Git Submodules",
        "icon": "$(repo-clone)"
      },
      {
        "command": "submoduleUpdate.remote",
        "title": "Remote All",
        "category": "Git Submodules",
        "icon": "$(cloud-download)"
      },
      {
        "command": "submoduleUpdate.initOne",
        "title": "Init",
        "category": "Git Submodules",
        "icon": "$(repo-clone)"
      },
      {
        "command": "submoduleUpdate.remoteOne",
        "title": "Remote",
        "category": "Git Submodules",
        "icon": "$(cloud-download)"
      },
      {
        "command": "submoduleUpdate.refreshView",
        "title": "Refresh",
        "category": "Git Submodules",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "submoduleUpdate.view",
          "name": "Submodules",
          "visibility": "visible"
        }
      ]
    },
    "submenus": [
      {
        "id": "submoduleUpdate.submenu",
        "label": "Submodules"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "submoduleUpdate.init",
          "when": "scmProvider == git",
          "group": "navigation"
        },
        {
          "command": "submoduleUpdate.remote",
          "when": "scmProvider == git",
          "group": "navigation"
        },
        {
          "submenu": "submoduleUpdate.submenu",
          "when": "scmProvider == git",
          "group": "2_main@9"
        }
      ],
      "submoduleUpdate.submenu": [
        {
          "command": "submoduleUpdate.init",
          "group": "1_update@1"
        },
        {
          "command": "submoduleUpdate.remote",
          "group": "1_update@2"
        }
      ],
      "view/title": [
        {
          "command": "submoduleUpdate.refreshView",
          "when": "view == submoduleUpdate.view",
          "group": "navigation@1"
        },
        {
          "command": "submoduleUpdate.init",
          "when": "view == submoduleUpdate.view",
          "group": "navigation@2"
        },
        {
          "command": "submoduleUpdate.remote",
          "when": "view == submoduleUpdate.view",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "submoduleUpdate.initOne",
          "when": "view == submoduleUpdate.view && viewItem == submodule",
          "group": "inline@1"
        },
        {
          "command": "submoduleUpdate.remoteOne",
          "when": "view == submoduleUpdate.view && viewItem == submodule",
          "group": "inline@2"
        },
        {
          "command": "submoduleUpdate.initOne",
          "when": "view == submoduleUpdate.view && viewItem == submodule",
          "group": "1_actions@1"
        },
        {
          "command": "submoduleUpdate.remoteOne",
          "when": "view == submoduleUpdate.view && viewItem == submodule",
          "group": "1_actions@2"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/at-besa/git-submodule-update.git"
  },
  "bugs": {
    "url": "https://github.com/at-besa/git-submodule-update/issues"
  },
  "homepage": "https://github.com/at-besa/git-submodule-update#readme",
  "scripts": {
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@vscode/vsce": "^4.0.0",
    "semantic-release": "^25.0.9"
  }
}
